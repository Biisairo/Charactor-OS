# LLM API 설정
# OpenAI, Ollama, Azure OpenAI 등 OpenAI 호환 API를 지원합니다.

# (필수) API 키 — 서비스마다 형식이 다를 수 있습니다.
#   OpenAI:  https://platform.openai.com/api-keys
#   Ollama:  ollama (아무 값이나 넣어도 됨, 로컬만 사용하므로)
OPENAI_API_KEY=sk-your-api-key-here

# (선택) 모델명 — 미지정 시 gpt-4o
#   OpenAI: gpt-4o, gpt-4o-mini, gpt-3.5-turbo ...
#   Ollama: llama3, mistral, gemma2 ...
OPENAI_MODEL=gpt-4o-mini

# (선택) API 엔드포인트 — 미지정 시 api.openai.com
#   OpenAI:   (비워두면 자동)
#   Ollama:   http://localhost:11434/v1
#   Azure:    https://your-resource.openai.azure.com
OPENAI_BASE_URL=


# ---------------------------------------------------------------------------
# 평가(eval) 설정 — 응답 품질 평가에서 판정자로 사용합니다.
#
# 대화용과 완전히 분리된 키·엔드포인트·모델을 사용합니다.
# 판정자를 다른 프로바이더에 둘 수 있고, 평가 비용을 대화 비용과
# 분리해 추적할 수 있습니다. 자기 편향을 줄이기 위해 대화용보다
# 상위 모델을 지정하는 것을 권장합니다.
#
# 평가를 실행하지 않으면 아래 값은 필요하지 않습니다.
# ---------------------------------------------------------------------------

EVAL_API_KEY=sk-your-eval-api-key-here
EVAL_MODEL=gpt-4o
EVAL_BASE_URL=
